<main class="site">
  <div class="reader">
    <div class="app-hd">
      <img class="app-icon" src="<%- url_for(page.icon) %>" alt="<%= page.title %>" width="112" height="112">
      <div class="app-hd-text">
        <h1><%= page.title %></h1>
        <% if (page.subtitle) { %><p class="app-sub"><%= page.subtitle %></p><% } %>
        <a class="app-store" href="<%- page.appstore %>" target="_blank" rel="noopener"><img src="<%- url_for('/images/appstore.png') %>" alt="App Store からダウンロード"></a>
      </div>
    </div>
    <div class="app-gallery">
      <% [['iPhone', page.screenshots], ['iPhone Duo', page.duo_screenshots]].forEach(function (set) { if (!set[1] || !set[1].length) return; %>
      <h2 class="app-shots-hd"><%= set[0] %></h2>
      <div class="app-shots">
        <% set[1].forEach(function (src, i) { %>
        <img src="<%- url_for(src) %>" alt="<%= page.title %> の <%= set[0] %> スクリーンショット <%= i + 1 %>" loading="lazy">
        <% }) %>
      </div>
      <% }) %>
    </div>
    <article class="prose">
      <%- page.content %>
      <h2>プライバシー</h2>
      <p><%= page.privacy %></p>
    </article>
  </div>
</main>
